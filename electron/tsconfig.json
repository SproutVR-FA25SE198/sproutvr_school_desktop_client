{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "NodeNext",
    "outDir": "../dist-electron",
    "skipLibCheck": true,
    "baseUrl": "../",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "main/**/*",
    "preload/**/*"
  ]
}