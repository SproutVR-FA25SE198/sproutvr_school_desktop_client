{
  "appId": "sproutvr",
  "files": ["dist-electron", "dist-react", ".env"],
  "extraResources": [
    "dist-electron/preload/preload.cjs",
    "src/assets/**",
    {
      "from": ".env",
      "to": ".env"
    }
  ],
  "icon": "public/SproutVR_Icon.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": ["portable", "msi"]
  }
}
